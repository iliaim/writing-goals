{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/repo/.codex/hooks/gate.codex.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/repo/.codex/hooks/deny-list.sh"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/repo/.codex/hooks/deny-list.sh"
          }
        ]
      }
    ]
  }
}
